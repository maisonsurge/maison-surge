# =============================================================================
# MAISON SURGE — environment variables
# Copy to .env.local for local development:   cp .env.example .env.local
# On Vercel: Project → Settings → Environment Variables (never commit secrets).
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and never reach the browser.
# =============================================================================

# --- Site --------------------------------------------------------------------
# Public base URL (no trailing slash). Used for canonical URLs, sitemap, auth
# email redirects and payment callbacks. Production: https://<your-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Dashboard → Project Settings → API) ---------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "anon" public key (or the new "publishable" key via NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY).
# Safe in the browser: every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key (or new "secret" key). SERVER ONLY — bypasses RLS.
# Used by checkout, carts, webhooks, signed uploads, cron. NEVER expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ----------------------------------------------------------------
# mock   = sandbox provider with a clearly labelled TEST page (no real money)
# iyzico = iyzico Checkout Form (requires merchant account; adapter UNVERIFIED — see docs/RELEASE_CHECKLIST.md)
PAYMENT_PROVIDER=mock
# HMAC secret for the mock provider's signed webhooks (>= 16 chars).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOCK_PAYMENT_WEBHOOK_SECRET=
# The mock provider is DISABLED on the Vercel production deployment unless this is "true"
# (only for a staging/demo site — never for a real store).
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false

# iyzico (merchant panel → Ayarlar → API anahtarları). Sandbox: https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- Security / operations ---------------------------------------------------
# Bearer secret for /api/cron/release-reservations (Vercel Cron sends it automatically).
CRON_SECRET=
# Salt for hashing IP addresses used as rate-limit keys (raw IPs are never stored).
IP_HASH_SALT=

# --- Email (optional) --------------------------------------------------------
# Transactional emails (order confirmation, newsletter double opt-in) via Resend.
# If empty, NO email is sent and the app says so in logs (nothing is faked).
# Supabase Auth emails (sign-up, password reset) are configured in Supabase → Auth → SMTP.
RESEND_API_KEY=
# Verified sender, e.g. "MAISON SURGE <siparis@your-domain>"
EMAIL_FROM=

# --- E2E tests (optional, local only) ----------------------------------------
# Credentials of a dedicated TEST admin in a TEST Supabase project for Playwright.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
